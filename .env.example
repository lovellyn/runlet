# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=

# Optional GitHub HTTPS credential, intentionally available to executed jobs.
# GITHUB_TOKEN=

# Optional commit identity for newly created workspaces.
# GIT_USER_NAME="Sandbox Agent"
# GIT_USER_EMAIL=agent@example.com

# Server configuration. Docker sets SANDBOX_ROOT=/data.
# SANDBOX_ROOT=var
# PORT=8000
# MAX_CONCURRENT_JOBS=2
# MAX_WORKSPACES=32
# MAX_JOB_RECORDS=256
# DEFAULT_JOB_TIMEOUT=300
# MAX_JOB_TIMEOUT=3600
# MAX_OUTPUT_BYTES=1048576
# RESPONSE_BYTES=65536
# MAX_FILE_BYTES=1048576
# SETUP_TIMEOUT=180

# Optional file exports. Use the externally reachable server URL, without /mcp.
# PUBLIC_BASE_URL=https://sandbox.example.com
# EXPORT_TTL_SECONDS=900
# MAX_EXPORT_BYTES=268435456
# MAX_EXPORTS=16

# Extra exact public hosts and browser origins; comma-separated.
# Localhost defaults remain enabled. Set these explicitly behind a reverse proxy.
# ALLOWED_HOSTS=sandbox.example.com
# ALLOWED_ORIGINS=https://sandbox.example.com

# Example client only.
# SANDBOX_URL=http://localhost:8000/mcp
# Optional Bearer credential for an upstream authenticated gateway.
# GATEWAY_TOKEN=
